{
  "schemaVersion": 1,
  "id": "nyalib-entity",
  "version": "${version}",

  "name": "NyaLib Entity",
  "description": "A module providing APIs for entities",
  "authors": [
    "DanyGames2014"
  ],

  "license": "MIT",
  "icon": "assets/nyalib-entity/icon.png",

  "environment": "*",
